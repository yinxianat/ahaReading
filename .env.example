# AhaReading environment template.
#
# Copy to `.env` for local development:  cp .env.example .env
# `.env` is git-ignored — NEVER commit it. This file must only ever contain
# obviously-fake placeholders. Real values live in `.env` (local) or in the
# Railway service's Variables tab (production).
#
# Scope legend:
#   [ALL]        set locally and on Railway
#   [PROD]       set on Railway only
#   [LOCAL ONLY] never set on Railway
#
# Generate secrets with:  openssl rand -hex 32
#
# Each setting shows an example value ("e.g."). Examples are fake: replace them with yours.

# ─── Database ────────────────────────────────────────
# [ALL] Railway injects this automatically for its managed Postgres.
# e.g. local, no password:   postgresql://jane@localhost:5432/ahareading
# e.g. local with password:  postgresql://jane:YOUR_DB_PASSWORD@localhost:5432/ahareading
DATABASE_URL="postgresql://YOUR_DB_USER@localhost:5432/ahareading"
# [LOCAL ONLY] Database used by `npm test`. Must differ from DATABASE_URL and end in _test.
# e.g. postgresql://jane@localhost:5432/ahareading_test
TEST_DATABASE_URL="postgresql://YOUR_DB_USER@localhost:5432/ahareading_test"

# ─── Auth (REQUIRED — the app fails closed without them) ─
# Both must be at least 32 characters; shorter values are refused and /api/health returns 503.
# [ALL] Signs session JWTs. Use a different value per environment.
# e.g. 64 hex characters, the output of `openssl rand -hex 32` (never reuse an example)
JWT_SECRET="replace-with-openssl-rand-hex-32"
# [ALL] Keys the HMAC of stored magic-link tokens.
MAGIC_LINK_SECRET="replace-with-a-different-openssl-rand-hex-32"
# [ALL] Optional; default 30. 0 or garbage falls back to 30.  e.g. 30 (a month), 7 (a week)
SESSION_EXPIRY_DAYS="30"

# ─── Base URL ────────────────────────────────────────
# [ALL] REQUIRED in production — magic links are built from this, never from request headers.
# e.g. local: http://localhost:3000   production: https://ahareading.up.railway.app (no trailing slash)
BASE_URL="http://localhost:3000"

# ─── AI provider chain ───────────────────────────────
# [ALL] Comma-separated, tried in order. Providers without a key are skipped.
# e.g. anthropic,openai,google   (one provider: anthropic)   (no AI account, local only: mock)
AI_PROVIDER_CHAIN="anthropic,openai,google"
# [ALL] Optional per-provider timeout in ms; default 12000 (clamped 1000..120000).  e.g. 12000
AI_TIMEOUT_MS=""
# [ALL] Optional deadline for the whole provider chain in ms; default 25000. Keep it below
# the client's 35 s explain/translate timeout so failover can finish before the user gives up.  e.g. 25000
AI_CHAIN_DEADLINE_MS=""
# [ALL] Optional explains + translations (cache misses) per user per UTC day; default 300.  e.g. 300
AI_DAILY_LIMIT_PER_USER=""
# [PROD] Optional app-wide AI token ceiling per UTC day; blank = no ceiling. When reached,
# explain/translate answer 503 ai_unavailable and the admin is alerted.  e.g. 2000000 (2M tokens/day)
AI_DAILY_TOKEN_BUDGET=""

# [ALL] Set the keys you have. Get them from each provider's console:
#   Anthropic  console.anthropic.com  (keys start with sk-ant-...)
#   OpenAI     platform.openai.com    (keys start with sk-...)
#   Google     aistudio.google.com    (keys start with AIza...)
ANTHROPIC_API_KEY=""
ANTHROPIC_MODEL=""          # optional, default claude-opus-5-5; e.g. claude-sonnet-5-5 (cheaper), claude-haiku-5-5 (cheapest)
OPENAI_API_KEY=""
OPENAI_MODEL=""             # optional; e.g. gpt-4o-mini
GOOGLE_AI_API_KEY=""        # GEMINI_API_KEY is also accepted
GOOGLE_AI_MODEL=""          # optional; e.g. gemini-2.5-flash

# [ALL] Optional task-specific model overrides; used only by the provider that has that model.
# e.g. AI_EXPLAIN_MODEL=claude-opus-5-5   AI_TRANSLATE_MODEL=claude-haiku-5-5
AI_EXPLAIN_MODEL=""
AI_TRANSLATE_MODEL=""
# [ALL] Optional model for Aha Listening scripts (longer answers); e.g. claude-sonnet-5-5
AI_LISTEN_MODEL=""

# ─── Aha Listening: daily audio minutes (lib/entitlements.js) ───
# [ALL] Minutes of audio a user can have written per UTC day, by plan. 0 turns listening off
# for that plan. Future paid plans read AUDIO_DAILY_MINUTES_<PLAN> (e.g. AUDIO_DAILY_MINUTES_PRO).
# Admins are the accounts in ADMIN_EMAILS.  e.g. 240 (admins)  60 (everyone else)
AUDIO_DAILY_MINUTES_ADMIN="240"
AUDIO_DAILY_MINUTES_USER="60"
# [ALL] Optional JSON price overrides per 1M tokens, e.g. {"model-id":{"input":1,"output":5}}
AI_PRICE_OVERRIDES=""

# [LOCAL ONLY] Deterministic fake AI provider for development and E2E tests.
# Ignored when NODE_ENV=production. Use with AI_PROVIDER_CHAIN="mock".  e.g. 1 (on) or blank (off)
AI_MOCK=""

# ─── SMTP (magic-link emails) ────────────────────────
# [PROD] Without SMTP in development, the sign-in link is printed to the server console
# and returned as `devLink`. SMTP_USERNAME / SMTP_PASSWORD are accepted as aliases.
# e.g. Gmail:   SMTP_HOST=smtp.gmail.com  SMTP_PORT=587  SMTP_SECURE=false
#               SMTP_USER=you@gmail.com   SMTP_PASS=<16-character Google App Password, not your Gmail password>
# e.g. Resend:  SMTP_HOST=smtp.resend.com SMTP_PORT=465  SMTP_SECURE=true  SMTP_USER=resend  SMTP_PASS=<API key>
# SMTP_SECURE=true for port 465; false for 587 (encryption is negotiated automatically).
SMTP_HOST=""
SMTP_PORT="587"
SMTP_SECURE="false"
SMTP_USER=""
SMTP_PASS=""
SMTP_FROM="AhaReading <noreply@example.com>"   # e.g. AhaReading <you@gmail.com> (Gmail sends as the signed-in account)

# ─── Proxy ───────────────────────────────────────────
# [PROD] Header the platform edge sets to the real client IP (rate-limit keys only).
# Default x-real-ip (Railway). Set to x-forwarded-for to use that header's rightmost hop.  e.g. x-real-ip
TRUSTED_IP_HEADER=""

# ─── Admin & monitoring ──────────────────────────────
# [ALL] Comma-separated admin emails. Empty = nobody is admin (never everybody).
# e.g. you@example.com,teammate@example.com
ADMIN_EMAILS="you@example.com"
# [ALL] Optional kill switches; default on. Set to "false" to disable.  e.g. false (stop admin alert emails)
ALERTS_ENABLED=""
LOG_PERSISTENCE=""

# [LOCAL ONLY] Build folder for `next dev`/`next build`; default .next. The e2e server sets
# .next-qa so it can run beside your own dev server. Leave blank.
NEXT_DIST_DIR=""

# NODE_ENV is set by Railway (production) and by Next.js locally — do not set it here.
